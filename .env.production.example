# AWS Lightsail production .env — copy on server: cp .env.production.example .env && nano .env
#
# Defaults here target the US$12 "Small" 2 GB instance: filesystem storage
# instead of MinIO, and prebuilt images pulled from GHCR instead of building
# on the box. See the 4 GB notes at the bottom to switch.
#
# NO DOMAIN PURCHASED? Use sslip.io (free). If the Lightsail STATIC IPv4 is
# 13.55.12.34, run locally:
#   ./scripts/sslip-hostnames.sh 13.55.12.34
# and paste the output below.
#
# Use the static IP, not the instance's default public IP — that one changes
# every time the instance stops.

# --- Which compose files to use. Lets every command be just `docker compose up -d`. ---
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.small.yml:docker-compose.registry.yml

APP_PASSWORD=choose-a-strong-password
NODE_ENV=production

# --- Free hostname (sslip.io) — replace 13-55-12-34 with YOUR STATIC IPv4 (dots → dashes) ---
DOMAIN=13-55-12-34.sslip.io
ACME_EMAIL=your-email@gmail.com
PUBLIC_APP_URL=https://13-55-12-34.sslip.io

# --- OR use a real domain you own (uncomment and edit instead) ---
# DOMAIN=nexus.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
# PUBLIC_APP_URL=https://nexus.yourdomain.com

# Docker-internal (leave as-is)
DATABASE_URL=postgres://nexus:nexus@db:5432/nexus
REDIS_URL=redis://redis:6379

# --- Storage: local disk on the 2 GB profile (no MinIO process) ---
STORAGE_PROVIDER=fs
NEXUS_FILES_DIR=/data/files
# Signs the temporary /api/files download links. Generate with:
#   openssl rand -base64 24
# Keep it separate from APP_PASSWORD so rotating the login does not break links.
FILES_SIGNING_SECRET=

# --- Prebuilt images (GitHub Actions publishes these on every push to deploy) ---
NEXUS_IMAGE_OWNER=jatinsharma-create
NEXUS_IMAGE_TAG=latest

# Provider selection — one line each. Adapters live under app/modules/.
VOICE_PROVIDER=telnyx
STT_PROVIDER=groq
LLM_PROVIDER=google
PDF_RENDERER=puppeteer

# Neutral calling (falls back to TELNYX_* below if left blank)
VOICE_CALLER_ID=
VOICE_AGENT_ENDPOINT=

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite

# Groq STT
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telnyx adapter (unused if VOICE_PROVIDER is not telnyx)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
TELNYX_CALLER_ID=+1XXXXXXXXXX
TELNYX_SIP_URI=sip:your_sip_username@sip.telnyx.com

NEXUS_COMPANY_NAME=Nexus Recruiting
CONSENT_GATHER_TIMEOUT_SECS=10
CONSENT_MAX_RETRIES=2
RECORDING_ENABLED=true
AMD_ENABLED=false

# ---------------------------------------------------------------------------
# Moving up to the 4 GB (US$24) instance later?
#
#   1. Drop the small/registry overrides so MinIO runs and images build here:
#        COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#   2. Switch storage back to MinIO and add its settings:
#        STORAGE_PROVIDER=s3
#        FILES_DOMAIN=files.13-55-12-34.sslip.io
#        MINIO_PUBLIC_ENDPOINT=https://files.13-55-12-34.sslip.io
#        MINIO_ENDPOINT=storage
#        MINIO_PORT=9000
#        MINIO_ACCESS_KEY=admin
#        MINIO_SECRET_KEY=change-this-minio-password-in-production
#        MINIO_BUCKET=nexus
#
# Files already written to the `files` volume stay on disk; existing rows keep
# pointing at keys the fs provider serves, so migrate deliberately rather than
# flipping this on a live system with data you care about.
# ---------------------------------------------------------------------------
