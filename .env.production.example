# AWS Lightsail production .env — copy on server: cp .env.production.example .env && nano .env
#
# NO DOMAIN PURCHASED? Use sslip.io (free). If your static IP is 54.123.45.67, run locally:
#   ./scripts/sslip-hostnames.sh 54.123.45.67
# and paste the output below.

APP_PASSWORD=choose-a-strong-password
NODE_ENV=production

# --- Free hostname (sslip.io) — replace 54-123-45-67 with YOUR static IP (dots → dashes) ---
DOMAIN=54-123-45-67.sslip.io
FILES_DOMAIN=files.54-123-45-67.sslip.io
ACME_EMAIL=your-email@gmail.com
PUBLIC_APP_URL=https://54-123-45-67.sslip.io
MINIO_PUBLIC_ENDPOINT=https://files.54-123-45-67.sslip.io

# --- OR use a real domain you own (uncomment and edit instead) ---
# DOMAIN=nexus.yourdomain.com
# FILES_DOMAIN=files.nexus.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
# PUBLIC_APP_URL=https://nexus.yourdomain.com
# MINIO_PUBLIC_ENDPOINT=https://files.nexus.yourdomain.com

# Docker-internal (leave as-is on Lightsail)
DATABASE_URL=postgres://nexus:nexus@db:5432/nexus
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-this-minio-password-in-production
MINIO_BUCKET=nexus

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite

# Groq STT
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
TELNYX_CALLER_ID=+1XXXXXXXXXX
TELNYX_SIP_URI=sip:your_sip_username@sip.telnyx.com

NEXUS_COMPANY_NAME=Nexus Recruiting
CONSENT_GATHER_TIMEOUT_SECS=10
CONSENT_MAX_RETRIES=2
RECORDING_ENABLED=true
AMD_ENABLED=false
