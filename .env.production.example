# Production environment variables (Vercel + Railway worker)
# Copy values into each platform's dashboard — do NOT commit real secrets.

APP_PASSWORD=choose-a-strong-password
DOMAIN=your-app.vercel.app
NODE_ENV=production

# Neon Postgres (pooled connection string, sslmode=require)
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require

# Upstash Redis
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# Cloudflare R2 (S3-compatible)
MINIO_BUCKET=nexus
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_USE_SSL=true
MINIO_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite

# Groq STT
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telnyx — same keys as local
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
TELNYX_CALLER_ID=+1XXXXXXXXXX
TELNYX_SIP_URI=sip:your_sip_username@sip.telnyx.com

# Must match your Vercel URL exactly (HTTPS, no trailing slash)
PUBLIC_APP_URL=https://your-app.vercel.app

NEXUS_COMPANY_NAME=Nexus Recruiting
CONSENT_GATHER_TIMEOUT_SECS=10
CONSENT_MAX_RETRIES=2
RECORDING_ENABLED=true
AMD_ENABLED=false
