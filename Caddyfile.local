{
	# Local: serve HTTP for ngrok, and HTTPS with Caddy's internal CA for browsers.
	# Without this, https://localhost fails with "connection failed" because :443
	# was published but nothing answered TLS.
	local_certs
	auto_https disable_redirects
}

localhost {
	tls internal
	reverse_proxy app:3000
}

:80 {
	reverse_proxy app:3000
}
