# Copy to .env and fill in values:  cp .env.example .env
DOMAIN=localhost
APP_PASSWORD=supersecretpassword

# Postgres (must match db service credentials in docker-compose.yml)
DATABASE_URL=postgres://nexus:nexus@db:5432/nexus
REDIS_URL=redis://redis:6379

# ── Provider selection ────────────────────────────────────────────────────────
# Each capability is a swappable module under app/modules/. Changing one of
# these lines changes the vendor; no application code changes.
VOICE_PROVIDER=telnyx          # telnyx | fake
STT_PROVIDER=groq              # groq | gemini
LLM_PROVIDER=google            # google
STORAGE_PROVIDER=s3            # s3 (MinIO, AWS, R2, …)
PDF_RENDERER=puppeteer         # puppeteer

# MinIO / S3-compatible storage
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=nexus
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Gemini (resume parse + call summaries)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite

# ── Calling (provider-neutral) ────────────────────────────────────────────────
# REQUIRED for live calling: a public HTTPS URL (ngrok). Without it, the callee
# answers to silence because the provider cannot deliver webhooks / play the IVR.
#   docker compose --profile tunnel up -d     (uses NGROK_* below)
#   ./scripts/start-tunnel.sh                 (host ngrok instead)
# Then point the provider's webhook at: $PUBLIC_APP_URL/api/webhooks/voice/telnyx
PUBLIC_APP_URL=https://xxxx.ngrok-free.app

# Tunnel container. NGROK_DOMAIN is the reserved domain (PUBLIC_APP_URL without
# the scheme) so the webhook address stays stable across restarts.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=xxxx.ngrok-free.app

# Caller ID shown to the candidate.
VOICE_CALLER_ID=+1XXXXXXXXXX
# Where the recruiter's audio goes. Prefix decides the kind:
#   sip:…     SIP URI          client:name   provider client identity
#   anything else is treated as a phone number to ring.
VOICE_AGENT_ENDPOINT=sip:your_sip_username@sip.telnyx.com

# Consent & branding
NEXUS_COMPANY_NAME=Nexus Recruiting
# Optional: override the IVR consent line (leave blank for default)
IVR_CONSENT_ANNOUNCEMENT=
CONSENT_GATHER_TIMEOUT_SECS=10
CONSENT_MAX_RETRIES=2
RECORDING_ENABLED=true

# Answering machine detection (outbound PSTN).
# Default OFF — AMD wait/hangup-on-beep was killing live answers when iPhone
# Live Voicemail / Call Screening answered first (looked like "no ring").
# The consent IVR always plays immediately when the call is answered.
AMD_ENABLED=false
AMD_HANGUP_ON_BEEP=false

# ── Telnyx adapter ────────────────────────────────────────────────────────────
# Read only inside app/modules/voice/providers/telnyx/. If you switch
# VOICE_PROVIDER, these become unused rather than needing to be removed.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
# Prefer AMD_MODE=premium_ios_call_screening_detection for iPhones.
AMD_MODE=premium_ios_call_screening_detection
# Legacy names — still honoured if VOICE_CALLER_ID / VOICE_AGENT_ENDPOINT are blank.
TELNYX_CALLER_ID=
TELNYX_SIP_URI=

# ── Transcription adapter ─────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
