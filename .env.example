# Rename to .env and fill in the values
DOMAIN=localhost
APP_PASSWORD=supersecretpassword

# Caddy config file: Caddyfile.local (ngrok) | Caddyfile (production HTTPS)
CADDYFILE=Caddyfile.local

# Postgres (app + worker). Override for production; must match db service credentials.
DATABASE_URL=postgres://nexus:nexus@db:5432/nexus

# Day 2
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=nexus
# Local:
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Production (free sslip.io example — no domain purchase):
# DOMAIN=203-0-113-10.sslip.io
# CADDYFILE=Caddyfile
# PUBLIC_APP_URL=https://203-0-113-10.sslip.io
# MINIO_PUBLIC_ENDPOINT=https://files.203-0-113-10.sslip.io

# Day 3 — Telnyx Call Control + WebRTC
# See README / Day 3 notes for where each value comes from in the Telnyx Mission Control Portal
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
TELNYX_CALLER_ID=+1XXXXXXXXXX
TELNYX_SIP_URI=sip:your_sip_username@sip.telnyx.com
PUBLIC_APP_URL=https://xxxx.ngrok-free.app

# Consent & Branding
NEXUS_COMPANY_NAME=Nexus Recruiting
# Optional: override the IVR consent line (leave blank to use the default in telnyx-call-flow.ts)
IVR_CONSENT_ANNOUNCEMENT=
CONSENT_GATHER_TIMEOUT_SECS=10
CONSENT_MAX_RETRIES=2
RECORDING_ENABLED=true

# Day 5 — STT & Async Job Queue
REDIS_URL=redis://redis:6379
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Day 6 — PDF generation (worker only; set automatically in Docker)
# Override if using a custom Chromium path during local testing:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Optional alternate: STT_PROVIDER=gemini (uses GOOGLE_GENERATIVE_AI_* above)

# Production guides: docs/DEPLOY.md (Oracle free) | docs/DEPLOY-AWS.md (AWS + cost + CI/CD)
